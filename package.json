    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "novo-cliente": "node --disable-warning=ExperimentalWarning scripts/new-tenant.js",
    "test": "node --disable-warning=ExperimentalWarning scripts/smoke-test.js",
    "fotos": "node --disable-warning=ExperimentalWarning scripts/fotos.js",
    "assets": "node scripts/assets.js"
  },
  "dependencies": {
    "pg": "^8.13.0"
  }
}
