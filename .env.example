# Porta do servidor
PORT=3000
# URL pública usada nos QR Codes e tags NFC (deixe vazio para detectar pelo navegador)
PUBLIC_URL=
# Chave da área da plataforma (/plataforma), para criar novos restaurantes
PLATFORM_KEY=troque-esta-chave
# Segredo usado para assinar o login da equipe
SESSION_SECRET=troque-este-segredo
# Caminho do banco SQLite
DB_PATH=data/cardapio.db
# Fotos reais dos pratos (npm run fotos). Chave grátis em https://www.pexels.com/api/
PEXELS_API_KEY=
